      "default": "system" },
    { "id": "wind", "title": "Wind speed", "type": "choice",
      "options": [
        { "value": "system", "label": "Console region" },
        { "value": "kmh", "label": "km/h" },
        { "value": "mph", "label": "mph" },
        { "value": "ms", "label": "m/s" },
        { "value": "kn", "label": "Knots" }
      ],
      "default": "system" },
    { "id": "photos", "title": "Background photos", "type": "toggle", "default": true }
  ]
