{
  "id": "weather",
  "title": "Weather",
  "description": "Current weather and forecast for your places, anywhere in the world.",
  "glyph": "glyph.png",
  "iconFallback": "cloud",
  "size": 2,
  "settings": [
    { "id": "units", "title": "Temperature", "type": "choice",
      "options": [
        { "value": "system", "label": "Console region" },
        { "value": "c", "label": "Celsius" },
        { "value": "f", "label": "Fahrenheit" }
